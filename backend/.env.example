# Makeable Jobs backend environment. Copy to .env and fill in values.
APP_NAME=Makeable Jobs API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres

# Redis + Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://makeable-jobs.vercel.app

# Firebase Cloud Messaging. On Render/Vercel use FIREBASE_CREDENTIALS_JSON
# (the raw service-account JSON as a single-line string); locally you can point
# FIREBASE_CREDENTIALS at the downloaded file instead.
FIREBASE_CREDENTIALS=path/to/firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=makeable-jobs

# AI (optional — users supply their own OpenAI or Gemini API key per request)

# Supabase (optional direct client for auth/storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Job providers (multi-source aggregation)
JOB_PROVIDER=serpapi
# Comma-separated providers queried by /jobs/search. Greenhouse/Ashby are
# company-board providers and join when a `company` filter is supplied.
ENABLED_PROVIDERS=serpapi,jsearch,usajobs,remoteok
SERPAPI_API_KEY=
SERPAPI_GL=IN
SERPAPI_MONTHLY_LIMIT=250
SERPAPI_CACHE_TTL_HOURS=6
USAJOBS_API_KEY=
USAJOBS_EMAIL=you@example.com
# JSearch key also powers /jobs/salary and /jobs/autocomplete (OpenWebNinja add-ons)
JSEARCH_API_KEY=

# Admin bootstrap
ADMIN_EMAIL=admin@makeable.example
ADMIN_PASSWORD=change-me